#!/bin/bash
# Ojo bun shim
# Intercepts bun calls and routes them through Ojo's trust layer.
# Gets placed into PATH ahead of the real bun binary.

SHIM_DIR="$(cd "$(dirname "$0")" && pwd)"
OJO_CLI="$(cd "$SHIM_DIR/../dist" && pwd)/index.js"

find_real_bun() {
  IFS=':' read -ra PARTS <<< "$PATH"
  for PART in "${PARTS[@]}"; do
    ABS_PART="$(cd "$PART" 2>/dev/null && pwd || echo "$PART")"
    if [ "$ABS_PART" != "$SHIM_DIR" ] && [ -x "$PART/bun" ]; then
      echo "$PART/bun"
      return 0
    fi
  done
  return 1
}

REAL_BUN=$(find_real_bun)
if [ -z "$REAL_BUN" ]; then
  echo "Ojo: error - cannot find real bun" >&2
  exit 1
fi

node "$OJO_CLI" shim bun "$@"
OJO_EXIT=$?

if [ $OJO_EXIT -ne 0 ]; then
  exit $OJO_EXIT
fi

exec "$REAL_BUN" "$@"
