{
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:docker": "pnpm --filter @ojo/providers test:docker",
    "clean": "turbo run clean",
    "format": "prettier --check \"**/*.{ts,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,json,md}\"",
    "publish": "pnpm build && pnpm --filter @itssergio91/ojo publish --no-git-checks",
    "publish:dry": "pnpm build && pnpm --filter @itssergio91/ojo publish --dry-run --no-git-checks"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.13.2",
  "engines": {
    "node": ">=22.0.0"
  }
}
